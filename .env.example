# Cadena de conexión a Postgres (Neon, Vercel Postgres, Supabase...)
DATABASE_URL=postgres://user:password@host/db

# Secreto para firmar las sesiones. Genera uno con: openssl rand -base64 32
AUTH_SECRET=cambiame

# Token de Vercel Blob para subir archivos y audios.
# En Vercel se crea automáticamente al añadir un Blob store al proyecto.
# En local: ejecuta `vercel env pull .env.local` o créalo en el dashboard.
BLOB_READ_WRITE_TOKEN=
